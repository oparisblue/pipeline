{
  "scripts": {
    "start": "cp -R ./src/static/* ./build/; yarn copy:ffmpeg; sass ./src/style/style.scss:./build/style.css; concurrently \"esbuild ./src/app/Pipeline.ts --bundle --outfile=./build/bundle.min.js --watch\" \"sass ./src/style/style.scss:./build/style.css\" \"http-server -c-1 -s -o ./build/\"",
    "build": "mkdir ./build/; cp -R ./src/static/* ./build/; yarn copy:ffmpeg; sass ./src/style/style.scss:./build/style.css; esbuild ./src/app/Pipeline.ts --bundle --outfile=./build/bundle.min.js",
    "copy:ffmpeg": "mkdir -p ./build/ffmpeg; cp ./node_modules/@ffmpeg/ffmpeg/dist/umd/ffmpeg.js ./node_modules/@ffmpeg/ffmpeg/dist/umd/814.ffmpeg.js ./node_modules/@ffmpeg/core/dist/umd/ffmpeg-core.js ./node_modules/@ffmpeg/core/dist/umd/ffmpeg-core.wasm ./build/ffmpeg/",
    "prettier:format": "prettier --config .prettierrc.json 'src/**/*.ts' 'src/**/*.scss' --write"
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "concurrently": "^8.2.1",
    "esbuild": "^0.19.3",
    "http-server": "^14.1.1",
    "prettier": "^3.1.0",
    "sass": "^1.68.0"
  },
  "dependencies": {
    "gifenc": "^1.0.3"
  },
  "packageManager": "yarn@1.22.22"
}